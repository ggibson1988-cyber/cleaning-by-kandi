# GoHighLevel integration for /api/submit-quote (a Vercel Edge Function —
# see api/submit-quote.ts). Server-side only, never exposed to the client
# bundle. BLOCKED: real production values for these are not available in
# this repo/session — see docs/ARCHITECTURE.md "Form integration contract"
# for what's needed before this goes live.
GHL_API_KEY=
GHL_LOCATION_ID=

# Client-side: absolute URL of the deployed /api/submit-quote function (see
# src/lib/ghlAdapter.ts). Required once the production frontend is served
# from a different origin than the API (e.g. GHL fronting cleaningbykandi.com
# while the function lives on Vercel) — a same-origin relative path would
# 404 in that setup. Leave unset for a same-origin deployment (direct
# Vercel, or local `vercel dev`), where the relative-path fallback works.
# Exposed to the client bundle (Vite's VITE_ prefix) — do not put secrets
# here, only the public API URL.
VITE_QUOTE_API_URL=
